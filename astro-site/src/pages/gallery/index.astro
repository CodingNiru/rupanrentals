---
import SiteLayout from "../../layouts/SiteLayout.astro";

const photos = [
	["1-Family-Rm-2nd-floor.jpg", "Family room, second floor"],
	["2-Living-Rm-1.jpg", "Living room 1"],
	["3-Kitchen-Dining.jpg", "Kitchen and dining area"],
	["4-Living-Rm-2.jpg", "Living room 2"],
	["5-Living-Rm-3.jpg", "Living room 3"],
	["6-Kitchen-2.jpg", "Kitchen 2"],
	["7-Laundry.jpg", "Laundry"],
	["8-Bedroom-1.jpg", "Bedroom 1"],
	["9-Bedroom-1-B.jpg", "Bedroom 1, alternate view"],
	["10-Bathroom-1-A.jpg", "Bathroom 1"],
	["11-Beach-view-from-upper-deck.jpg", "Beach view from upper deck"],
	["12-Sound-view-from-upper-deck.jpg", "Sound view from upper deck"],
	["13-Beach-View.jpg", "Beach view"],
	["14-Sound-view.jpg", "Sound view"],
	["15-Bedroom-2.jpg", "Bedroom 2"],
	["16-Bedroom-2-A.jpg", "Bedroom 2, alternate view"],
	["17-Bedroom-3.jpg", "Bedroom 3"],
	["18-Bedroom-3-A.jpg", "Bedroom 3, alternate view"],
	["19-Bedroom-3-B.jpg", "Bedroom 3, alternate view"],
	["20-Bathroom-3.jpg", "Bathroom 3"],
	["21-Family-Rm-2.jpg", "Family room 2"],
	["22-Bathroom-2.jpg", "Bathroom 2"],
	["23-Family-Rm-3.jpg", "Family room 3"],
	["24-Bedroom-4.jpg", "Bedroom 4"],
	["25-Bedroom-4-A.jpg", "Bedroom 4, alternate view"],
	["26-Bathroom-4.jpg", "Bathroom 4"],
	["27-Underneath-house.jpg", "Underneath the house"],
	["28-Outdoor-Shower.jpg", "Outdoor shower"],
	["29-House-Front.jpg", "House exterior"],
	["IMG_0847.jpg", "Outdoor hot tub"],
].map(([filename, caption]) => {
	const stem = filename.replace(/\.[^.]+$/, "");

	return {
		src: `/images/gallery/${filename}`,
		srcSet: `/images/optimized/gallery/${stem}-480.webp 480w, /images/optimized/gallery/${stem}-960.webp 960w`,
		caption,
	};
});
---

<SiteLayout
	title="Gallery"
	description="Browse photos of Beach Please, including living spaces, bedrooms, bathrooms, and the beach and sound views."
	activePage="gallery"
>
	<section class="page-heading">
		<div class="site-width">
			<p class="eyebrow">A closer look</p>
			<h1>Gallery</h1>
			<p>Browse the rooms, outdoor spaces, and water views at Beach Please.</p>
		</div>
	</section>

	<section class="site-width gallery-content" aria-label="Property photos">
		<div class="photo-grid">
			{photos.map((photo) => (
				<a
					class="photo-card"
					href={photo.src}
					target="_blank"
					rel="noreferrer"
					aria-label={`Open full-size photo of ${photo.caption} in a new tab`}
				>
					<figure>
						<picture class="photo-picture">
							<source srcset={photo.srcSet} sizes="(max-width: 440px) calc(100vw - 32px), (max-width: 760px) 274px, 360px" type="image/webp" />
							<img src={photo.src} alt="" width="960" height="720" loading="lazy" decoding="async" />
						</picture>
						<figcaption>
							<span>{photo.caption}</span>
							<span class="open-icon" aria-hidden="true">↗</span>
						</figcaption>
					</figure>
				</a>
			))}
		</div>

		<div class="gallery-cta">
			<div>
				<p class="eyebrow">Plan your visit</p>
				<h2>Want to see booking options?</h2>
			</div>
			<a class="button" href="/book-now/">View booking options <span aria-hidden="true">→</span></a>
		</div>
	</section>
</SiteLayout>

<style>
	.eyebrow {
		margin: 0 0 10px;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.page-heading {
		padding-block: 68px 58px;
		background: #eaf6f2;
		text-align: center;
	}

	h1,
	h2 {
		margin: 0;
		color: #163d4b;
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 500;
	}

	h1 {
		font-size: clamp(3rem, 7vw, 4.8rem);
	}

	.page-heading > div > p:last-child {
		max-width: 580px;
		margin: 15px auto 0;
		color: var(--muted);
		line-height: 1.7;
	}

	.gallery-content {
		padding-top: 40px;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.photo-card {
		display: block;
		overflow: hidden;
		border: 1px solid #e1ebe8;
		border-radius: 14px;
		background: white;
		box-shadow: 0 5px 18px rgb(18 60 80 / 6%);
		color: inherit;
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.photo-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 26px rgb(18 60 80 / 12%);
	}

	figure {
		margin: 0;
	}

	.photo-picture {
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		background: #e4efec;
	}

	.photo-picture img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 220ms ease;
	}

	.photo-card:hover img {
		transform: scale(1.035);
	}

	figcaption {
		display: flex;
		min-height: 54px;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 12px 15px;
		color: #163d4b;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.open-icon {
		flex: 0 0 auto;
		color: #155b60;
		font-size: 1.15rem;
	}

	.gallery-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: 44px;
		padding: 28px 32px;
		border-radius: 18px;
		background: #eaf6f2;
	}

	.gallery-cta h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
	}

	.button {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 12px 20px;
		border-radius: 999px;
		background: #123c50;
		color: white;
		font-weight: 800;
		text-decoration: none;
		transition: transform 160ms ease, box-shadow 160ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgb(0 0 0 / 16%);
	}

	@media (max-width: 760px) {
		.photo-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
		}

		.gallery-cta {
			align-items: flex-start;
			flex-direction: column;
			padding: 24px;
		}
	}

	@media (max-width: 440px) {
		.photo-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
