---
import SiteLayout from "../layouts/SiteLayout.astro";

const highlights = [
	{
		image: "/images/home/living-room.png",
		optimized: "/images/optimized/home/living-room",
		alt: "Bright living room with comfortable seating",
		title: "Living room and kitchen",
		text: "The bright living space has comfortable furnishings and natural light. The fully equipped kitchen includes modern appliances, cookware, and dishes.",
	},
	{
		image: "/images/home/bedroom.jpg",
		optimized: "/images/optimized/home/bedroom",
		alt: "One of the home's bedrooms",
		title: "Four bedrooms",
		text: "The home has four spacious bedrooms with comfortable beds, storage, and a TV in each bedroom. There are also two full bathrooms.",
	},
	{
		image: "/images/home/upstairs-living.jpg",
		optimized: "/images/optimized/home/upstairs-living",
		alt: "Upstairs living room with seating",
		title: "Upstairs living room",
		text: "The upstairs living room has a foosball table, a daybed, and a large flat-screen TV for relaxing or spending time together.",
	},
	{
		image: "/images/home/sound-view.jpg",
		optimized: "/images/optimized/home/sound-view",
		alt: "Water view from the upper deck",
		title: "Deck and beach views",
		text: "Take in the water views and sea breeze from the oceanfront balcony. The beach is a short walk away; beach chairs, umbrellas, and toys are provided.",
	},
];
---

<SiteLayout
	title="Welcome to Beach Please"
	description="Explore the Beach Please vacation rental in North Topsail Beach: four bedrooms, two full bathrooms, an upstairs living room, and a short walk to the beach."
	activePage="home"
>
	<section class="hero">
		<picture class="hero-picture">
			<source
				srcset="/images/optimized/gallery/29-House-Front-480.webp 480w, /images/optimized/gallery/29-House-Front-960.webp 960w"
				sizes="100vw"
				type="image/webp"
			/>
			<img
				class="hero-image"
				src="/images/gallery/29-House-Front.jpg"
				alt="Beach Please vacation home in North Topsail Beach"
				fetchpriority="high"
			/>
		</picture>
		<div class="hero-shade"></div>
		<div class="hero-copy site-width">
			<p class="eyebrow">North Topsail Beach, North Carolina</p>
			<h1>Welcome to <span>Beach Please</span></h1>
			<p>Experience the best of both worlds with stunning beach and sound views.</p>
			<a class="button button-coral" href="/book-now/">View booking options <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section class="quick-facts site-width" aria-label="Rental highlights">
		<ul>
			<li><strong>4</strong><span>bedrooms</span></li>
			<li><strong>2</strong><span>full bathrooms</span></li>
			<li><strong>Short walk</strong><span>to the beach</span></li>
		</ul>
	</section>

	<section class="intro site-width">
		<p class="eyebrow">Your coastal getaway</p>
		<h2>Make yourself at home by the water</h2>
		<p>
			Welcome to our short-term rental in beautiful North Topsail Beach. The home has space for family and friends, and the beach is just a short walk away.
		</p>
	</section>

	<section class="highlights site-width" aria-label="About the home">
		{highlights.map((highlight) => (
			<article class="highlight">
				<picture class="highlight-image">
					<source
						srcset={`${highlight.optimized}-480.webp 480w, ${highlight.optimized}-720.webp 720w`}
						sizes="(max-width: 700px) calc(100vw - 32px), 540px"
						type="image/webp"
					/>
					<img src={highlight.image} alt={highlight.alt} width="960" height="600" loading="lazy" decoding="async" />
				</picture>
				<div class="highlight-copy">
					<h3>{highlight.title}</h3>
					<p>{highlight.text}</p>
				</div>
			</article>
		))}
	</section>

	<section class="home-cta">
		<div class="site-width cta-inner">
			<div>
				<p class="eyebrow">Explore the home</p>
				<h2>See more photos or choose a booking option.</h2>
			</div>
			<div class="cta-actions">
				<a class="button button-outline" href="/gallery/">Browse the gallery</a>
				<a class="button button-light" href="/book-now/">Book your stay <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.hero {
		position: relative;
		display: grid;
		min-height: min(660px, 72svh);
		overflow: hidden;
		align-items: center;
		background: #356477;
		color: white;
	}

	.hero-picture,
	.hero-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-picture img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 57%;
	}

	.hero-shade {
		background: linear-gradient(90deg, rgb(9 39 52 / 80%), rgb(9 39 52 / 17%));
	}

	.hero-copy {
		position: relative;
		padding-block: 80px;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.hero .eyebrow {
		color: #c8f4e9;
	}

	h1,
	h2,
	h3 {
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 500;
	}

	h1 {
		max-width: 1080px;
		margin: 0;
		font-size: clamp(2.8rem, 6vw, 5.4rem);
		line-height: 1.03;
	}

	h1 span {
		color: #ffd2d9;
	}

	.hero-copy > p:not(.eyebrow) {
		max-width: 540px;
		margin: 22px 0 30px;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.65;
	}

	.button {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 12px 21px;
		border: 0;
		border-radius: 999px;
		font-weight: 800;
		text-decoration: none;
		transition: transform 160ms ease, box-shadow 160ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgb(0 0 0 / 16%);
	}

	.button-coral {
		background: #ef7285;
		color: #292b2d;
	}

	.quick-facts {
		position: relative;
		z-index: 1;
		margin-top: -28px;
	}

	.quick-facts ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin: 0;
		padding: 22px 30px;
		border-radius: 18px;
		background: white;
		box-shadow: 0 12px 36px rgb(18 60 80 / 12%);
		list-style: none;
	}

	.quick-facts li {
		display: grid;
		justify-items: center;
		gap: 3px;
		padding-inline: 12px;
		text-align: center;
	}

	.quick-facts li + li {
		border-left: 1px solid #dfe9e6;
	}

	.quick-facts strong {
		color: #163d4b;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.3rem, 2.5vw, 1.9rem);
		font-weight: 500;
	}

	.quick-facts span {
		color: var(--muted);
		font-size: 0.92rem;
	}

	.intro {
		max-width: 800px;
		padding-block: 78px 52px;
		text-align: center;
	}

	.intro h2,
	.home-cta h2 {
		margin: 0;
		color: #163d4b;
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1.14;
	}

	.intro > p:last-child {
		max-width: 690px;
		margin: 18px auto 0;
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.8;
	}

	.highlights {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		padding-bottom: 76px;
	}

	.highlight {
		overflow: hidden;
		border: 1px solid #e3ece9;
		border-radius: 18px;
		background: white;
		box-shadow: 0 10px 28px rgb(18 60 80 / 7%);
	}

	.highlight-image {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		background: #d9e8e5;
	}

	.highlight-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 220ms ease;
	}

	.highlight:hover .highlight-image img {
		transform: scale(1.025);
	}

	.highlight-copy {
		padding: 22px 24px 26px;
	}

	.highlight h3 {
		margin: 0;
		color: #163d4b;
		font-size: 1.5rem;
	}

	.highlight-copy p {
		margin: 10px 0 0;
		color: var(--muted);
		line-height: 1.7;
	}

	.home-cta {
		padding-block: 48px;
		background: #d9f1eb;
	}

	.cta-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
	}

	.home-cta h2 {
		max-width: 620px;
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.button-light {
		flex: 0 0 auto;
		background: #123c50;
		color: white;
	}

	.button-outline {
		border: 2px solid #123c50;
		background: transparent;
		color: #123c50;
	}

	@media (max-width: 700px) {
		.hero {
			min-height: 560px;
		}

		.hero-shade {
			background: linear-gradient(90deg, rgb(9 39 52 / 82%), rgb(9 39 52 / 30%));
		}

		.quick-facts {
			margin-top: -20px;
		}

		.quick-facts ul {
			padding: 18px 10px;
		}

		.quick-facts li {
			padding-inline: 5px;
		}

		.quick-facts span {
			font-size: 0.82rem;
		}

		.intro {
			padding-block: 62px 38px;
		}

		.highlights {
			grid-template-columns: 1fr;
			gap: 18px;
			padding-bottom: 56px;
		}

		.highlight-copy {
			padding: 20px;
		}

		.cta-inner {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 390px) {
		.quick-facts ul {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.quick-facts li + li {
			border-top: 1px solid #dfe9e6;
			border-left: 0;
			padding-top: 12px;
		}
	}
</style>
